{
	"methods": {
		"notes.search": {
			"description": "The notes whose title contains a text (all of them without one), most recent first",
			"effect": "read",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query": { "type": "string", "maxLength": 200, "description": "A text the title contains (case-insensitive)" },
					"limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
				}
			},
			"output": {
				"type": "array",
				"items": {
					"type": "object",
					"required": ["id", "title"],
					"properties": {
						"id": { "type": "string" },
						"title": { "type": "string" }
					}
				}
			}
		}
	}
}
