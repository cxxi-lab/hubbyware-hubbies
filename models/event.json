{
	"collection": "event",
	"version": 1,
	"fields": {
		"title": { "type": "string", "max": 255, "required": true },
		"description": { "type": "text", "max": 100000 },
		"categoryId": { "type": "ref", "collection": "category", "onDelete": "nullify" },
		"startsAt": { "type": "datetime", "required": true },
		"endsAt": { "type": "datetime" },
		"until": { "type": "datetime", "required": true, "description": "endsAt, else startsAt: with startsAt, the window an event overlaps (kept by the module)" },
		"allDay": { "type": "bool", "default": false }
	},
	"indexes": [
		{ "fields": [["startsAt", 1]] },
		{ "fields": [["until", 1]] },
		{ "fields": [["categoryId", 1]] }
	]
}
