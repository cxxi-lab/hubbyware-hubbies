{
	"id": "mail",
	"version": "1.14.2",
	"sdk": "^3.9.1",
	"label": "Mail",
	"description": "Your mailboxes in one place",
	"icon": "envelope",
	"supports": [
		"notifications"
	],
	"capabilities": [
		"mail"
	],
	"scopes": [
		"app:notifications"
	],
	"oauth": {
		"google": [
			"https://mail.google.com/"
		],
		"microsoft": [
			"https://outlook.office.com/IMAP.AccessAsUser.All",
			"https://outlook.office.com/SMTP.Send"
		]
	},
	"isolated": true,
	"settingsPage": "/mail/settings",
	"storageFrom": [
		"mail.folder"
	]
}
