{
	"methods": {
		"timeline.items": {
			"description": "The workout sessions between two dates (performed, else scheduled), as dated items of a calendar; each opens the session in Workouts",
			"effect": "read",
			"interface": "timeline.items",
			"input": {
				"type": "object",
				"required": [
					"start",
					"end"
				],
				"properties": {
					"start": {
						"type": "string",
						"description": "ISO date-time"
					},
					"end": {
						"type": "string",
						"description": "ISO date-time"
					}
				}
			},
			"output": {
				"type": "array",
				"items": {
					"type": "object",
					"required": [
						"id",
						"date",
						"title",
						"href"
					],
					"properties": {
						"id": {
							"type": "string"
						},
						"date": {
							"type": "string"
						},
						"title": {
							"type": "string",
							"description": "The session's program"
						},
						"href": {
							"type": "string"
						},
						"color": {
							"type": "string"
						}
					}
				}
			}
		},
		"programs.list": {
			"description": "The workout programs (their names and how many exercises)",
			"effect": "read",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"properties": {}
			},
			"output": {
				"type": "array",
				"items": {
					"type": "object",
					"required": [
						"id",
						"name"
					],
					"properties": {
						"id": {
							"type": "string"
						},
						"name": {
							"type": "string"
						},
						"warmups": {
							"type": "integer"
						},
						"trainings": {
							"type": "integer"
						}
					}
				}
			}
		},
		"programs.get": {
			"description": "One program and its exercises (by its id or its name)",
			"effect": "read",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"program"
				],
				"properties": {
					"program": {
						"type": "string",
						"description": "its id or its name"
					}
				}
			},
			"output": {
				"type": "object",
				"required": [
					"id",
					"name",
					"exercises"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"exercises": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"enum": [
										"warmup",
										"training"
									]
								},
								"label": {
									"type": "string"
								},
								"series": {
									"type": "string"
								},
								"reps": {
									"type": "string"
								},
								"tempo": {
									"type": [
										"string",
										"null"
									]
								},
								"note": {
									"type": [
										"string",
										"null"
									]
								}
							}
						}
					}
				}
			}
		},
		"sessions.list": {
			"description": "The workout sessions in a period (performed or scheduled), by date",
			"effect": "read",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"from",
					"to"
				],
				"properties": {
					"from": {
						"type": "string",
						"description": "ISO date-time"
					},
					"to": {
						"type": "string",
						"description": "ISO date-time"
					}
				}
			},
			"output": {
				"type": "array",
				"items": {
					"type": "object",
					"required": [
						"id",
						"program"
					],
					"properties": {
						"id": {
							"type": "string"
						},
						"program": {
							"type": "string"
						},
						"scheduledAt": {
							"type": [
								"string",
								"null"
							]
						},
						"performedAt": {
							"type": [
								"string",
								"null"
							]
						},
						"note": {
							"type": [
								"string",
								"null"
							]
						},
						"exercises": {
							"type": "integer"
						}
					}
				}
			}
		},
		"sessions.get": {
			"description": "One session and its exercises, planned and done",
			"effect": "read",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id"
				],
				"properties": {
					"id": {
						"type": "string"
					}
				}
			},
			"output": {
				"type": "object",
				"required": [
					"id",
					"program",
					"exercises"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"program": {
						"type": "string"
					},
					"scheduledAt": {
						"type": [
							"string",
							"null"
						]
					},
					"performedAt": {
						"type": [
							"string",
							"null"
						]
					},
					"note": {
						"type": [
							"string",
							"null"
						]
					},
					"exercises": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"type": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"planned": {
									"type": "string",
									"description": "series × reps planned"
								},
								"done": {
									"type": "string",
									"description": "series × reps done"
								},
								"note": {
									"type": [
										"string",
										"null"
									]
								},
								"skipped": {
									"type": "boolean"
								},
								"extra": {
									"type": "boolean"
								}
							}
						}
					}
				}
			}
		},
		"sessions.create": {
			"description": "Schedules a session of a program (scheduledAt), or logs one done (performedAt; neither: done now)",
			"effect": "write",
			"input": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"program"
				],
				"properties": {
					"program": {
						"type": "string",
						"description": "its id or its name"
					},
					"scheduledAt": {
						"type": [
							"string",
							"null"
						]
					},
					"performedAt": {
						"type": [
							"string",
							"null"
						]
					},
					"note": {
						"type": [
							"string",
							"null"
						],
						"maxLength": 10000
					}
				}
			},
			"output": {
				"type": "object",
				"required": [
					"id",
					"program"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"program": {
						"type": "string"
					},
					"scheduledAt": {
						"type": [
							"string",
							"null"
						]
					},
					"performedAt": {
						"type": [
							"string",
							"null"
						]
					},
					"note": {
						"type": [
							"string",
							"null"
						]
					},
					"exercises": {
						"type": "integer"
					}
				}
			}
		}
	}
}
